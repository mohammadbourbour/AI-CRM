# SQLite path. Docker Compose overrides this to /app/data/crm.db.
DATABASE_URL=sqlite:///./data/crm.db

# Leave empty to use the mock LLM (keyword heuristics, not production inference).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Backend OpenAI SDK. Do not set this on the n8n Groq credential (causes /openai/v1 twice).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Leave empty to disable Telegram. Qualification still succeeds; channel notify is skipped.
# For a channel: add the bot as administrator, then set TELEGRAM_CHAT_ID to the channel id
# (-100…) or @channelusername. The bot posts the analysis result, not a customer message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opt-in n8n sales-team Telegram after a hot draft. Default false avoids double-send.
N8N_TELEGRAM_ALERTS=false

# WhatsApp Cloud API adapter (n8n, after human approval only).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

# Resend email adapter (n8n, after human approval only).
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret for POST /api/webhooks/leads (header X-Webhook-Secret).
# Demo-grade shared-secret auth, not production identity/auth.
WEBHOOK_SECRET=dev-webhook-secret-change-me

LOG_LEVEL=INFO

# Official n8n Google Sheets node (per-lead upsert after qualify).
# OAuth web client (Google Cloud → Credentials → OAuth client ID).
# Compose injects Client ID/Secret into n8n so you do not paste them in the UI.
# You still click Sign in with Google once (refresh token). Empty spreadsheet id → skip.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Qualified Leads

# Backend batch snapshot: POST /api/exports/google-sheets (service account).
# Complementary to the n8n per-lead upsert. Leave empty to skip.
GOOGLE_SHEETS_CREDENTIALS_FILE=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# Optional: host port for n8n if 5678 is already taken.
# N8N_PORT_HOST=5679

# Optional public n8n webhook the dashboard uses when via=n8n.
# Compose overrides N8N_WEBHOOK_URL to http://n8n:5678/webhook/lead-intake.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake
N8N_PUBLIC_URL=http://localhost:5678
